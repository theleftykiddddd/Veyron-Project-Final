{
  "target": {
    "geometryDash": "2.2081",
    "geode": "5.11.2",
    "platform": "Win64"
  },
  "hud": {
    "enabled": true,
    "position": "top-right",
    "scale": 0.8,
    "refreshIntervalSeconds": 0.1,
    "showsSimulationTick": true,
    "showsInputCount": true,
    "showsApproximateCps": true,
    "windowValue": "unknown-until-validated",
    "panelStyle": "dark-translucent",
    "accent": "state-dependent",
    "layout": "compact-multiline",
    "panelWidth": 244,
    "panelHeight": 104,
    "font": "chatFont.fnt",
    "opacity": 0.88,
    "showsLastAction": true,
    "showsSafeMode": true
  },
  "audio": {
    "enabled": true,
    "runtimeMuteDefault": false,
    "masterVolume": 0.55,
    "minFrequencyHz": 95,
    "maxFrequencyHz": 880,
    "waveform": "sine",
    "durationMs": 85,
    "pitchMapsTo": "inter-press-frame-interval",
    "runtimeToggle": "persistent-geode-setting",
    "frequencyMinHzRange": [
      50,
      500
    ],
    "frequencyMaxHzRange": [
      200,
      2000
    ]
  },
  "analysis": {
    "windowMeasurement": "not-implemented",
    "nominalTickRateHz": 240,
    "tickRateValidated": false,
    "capturePlayer1": true,
    "capturePlayer2": true
  },
  "recording": {
    "autoSave": true,
    "macroFile": "{mod_save_dir}/latest.vpr"
  },
  "playback": {
    "safeMode": true,
    "safeModeRequiresPractice": true,
    "releasesHeldInputsOnStopPauseResetQuit": true
  },
  "projectVersion": "0.3.0",
  "ui": {
    "popupStyle": "dark-panel-with-cyan-accent",
    "popupWidth": 360,
    "popupHeight": 250,
    "buttonLayout": "fixed-three-column-grid",
    "buttons": [
      "REC",
      "STOP",
      "PLAY",
      "SAVE",
      "LOAD",
      "HUD",
      "SOUND"
    ]
  }
}
